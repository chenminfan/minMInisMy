{
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    /* 配合 Vite 必須使用 ESM 模組解析 */
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    /* 路徑別名設定 */
    "baseUrl": "./src",
    "paths": {
      "@app/*": [
        "*"
      ],
      "@assets/*": [
        "assets/*"
      ],
      "@components/*": [
        "components/*"
      ],
      "@page/*": [
        "page/*"
      ],
      "@api/*": [
        "data/*"
      ],
      "@typeTS/*": [
        "typeTS/*"
      ],
      "@utils/*": [
        "utils/*"
      ],
      "@hook/*": [
        "hook/*"
      ]
    },
    "typeRoots": [
      "node_modules/@types",
      "./src/typeTS"
    ],
    "noEmitOnError": true,
    "noImplicitAny": false,
    "pretty": true
  },
  "include": [
    "src",
    "vite.config.js",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}